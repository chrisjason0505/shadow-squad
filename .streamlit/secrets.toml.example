# Copy to .streamlit/secrets.toml for local runs (never commit the real file),
# or paste these lines into the app's Secrets box on Streamlit Community Cloud (App settings > Secrets).

# Optional. Turns on free-form answers in Compare > "Ask why". Without it the app shows a built-in explanation.
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional. Model for the explainer; defaults to claude-opus-5-5.
# CLAUDE_MODEL = "claude-opus-5-5"
